# =====================================================================
#  Servidesk - configuración de una instancia
#
#  Copia este archivo como .env en la raíz del sitio (junto a index.html)
#  y ajusta los valores. El .env nunca se sube al repositorio y Apache
#  bloquea su acceso por web. Guía completa: DEPLOY.md
# =====================================================================

# --- Base de datos ----------------------------------------------------
# En Hostinger: hPanel > Bases de datos > MySQL (nombre y usuario llevan
# el prefijo de la cuenta, p. ej. u123456789_servidesk)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# --- Aplicación -------------------------------------------------------
# URL pública, sin "/" final
APP_URL=https://demo.tudominio.com
# Zona horaria de la operación del cliente
# (https://www.php.net/manual/es/timezones.america.php)
APP_TIMEZONE=America/Mexico_City
# Duración de la sesión en segundos (2592000 = 30 días)
SESSION_LIFETIME=2592000

# --- Marca de la plataforma (login) y valores por defecto -------------
# La marca de cada empresa (nombre, logo, colores, categorías, prefijo
# de folio, zona horaria) se guarda en la tabla empresas.
APP_NAME=Sistema
APP_TAGLINE="Gestión de servicios y mantenimiento"
# Razón social o nombre comercial (pie del login)
APP_COMPANY=Sistema
APP_LOGIN_FOOTER="Uso exclusivo de personal autorizado."
# Enlace "Aviso de privacidad" en el login (URL pública; vacío = sin enlace).
# Borrador base en docs/legal/aviso-de-privacidad.md
APP_AVISO_PRIVACIDAD_URL=
# Términos de uso del registro en línea y su versión (se guardan como constancia al registrarse)
APP_TERMINOS_URL=
APP_TERMINOS_VERSION=
# Logo del login y del inicio: ruta relativa a la raíz o URL absoluta.
# Recomendado: SVG o PNG horizontal con fondo transparente (~440x112).
APP_LOGO=img/logo.svg
# Ícono de pestaña. Vacío = img/favicon.ico, favicon-32.png y apple-touch-icon.png
APP_FAVICON=
# Colores en hexadecimal; hover y variantes del tema oscuro se calculan solos
BRAND_PRIMARY=#3498db
BRAND_PRIMARY_HOVER=
BRAND_SECONDARY=#1a4de4
BRAND_SIDEBAR=#2c3e50

# --- Operación --------------------------------------------------------
# Categorías de incidencia, separadas por coma
INCIDENCIA_CATEGORIAS="Mantenimiento correctivo,Mantenimiento preventivo,Instalación,Garantía,Diagnóstico,Otros"
# Prefijo de los folios de incidencia (SD-0001)
FOLIO_PREFIX=SD

# --- Registro autoservicio de pruebas (auth/registro.html) -----------
# true: el login muestra "Prueba gratis 15 días" y cualquiera puede crear su
# empresa en periodo de prueba. false: solo altas desde el panel de plataforma.
REGISTRO_ABIERTO=true
# Máximo de registros desde una misma IP en 24 horas (protección anti-abuso)
REGISTRO_MAX_POR_IP=3

# --- Modo demostración ------------------------------------------------
# true si la plataforma ofrece la demo pública (empresa 1, estado demo):
# página /demo con las credenciales visibles (el login de clientes nunca las
# muestra) y reinicio diario de esa empresa (cron/reset_demo.php). Las
# restricciones de demo aplican solo dentro de ella.
DEMO_MODE=false
# Cuentas protegidas (campo "usuario"), separadas por coma.
# La primera, con DEMO_PASSWORD, se muestra en la página /demo.
DEMO_CUENTAS=demo@sistema.com
DEMO_PASSWORD=demo123
# Hora local (APP_TIMEZONE) del reinicio diario
DEMO_RESET_HORA=03:00

# --- Respaldos (cron/respaldo_db.php) ---------------------------------
# Carpeta destino, de preferencia FUERA de public_html
# (p. ej. /home/u123456789/respaldos/cliente). Vacío = storage/backups
RESPALDO_DIR=
# Cuántos respaldos diarios conservar
RESPALDO_DIAS=14
# Hora local (APP_TIMEZONE) del respaldo
RESPALDO_HORA=02:00

# --- Solid Suite (D-50) ---------------------------------------------
# Con este token (24+ caracteres) la instancia la administra Solid Admin, el panel
# central de la suite: altas, planes, pagos y vigencias se hacen allá y llegan aquí
# por /api/solid/v1. Captura el mismo token en Solid Admin → Sistemas → Servidesk.
# Vacío = Servidesk se administra solo desde su panel /plataforma (como antes).
# Genera uno con:  php -r "echo bin2hex(random_bytes(24));"
SOLID_LINK_TOKEN=

# --- Analíticas internas de uso (opcional) ----------------------------
# Panel en /public/analiticas.php?k=TOKEN. Cadena aleatoria de 32+
# caracteres; vacío desactiva el panel.
ANALYTICS_TOKEN=
