# Reportes de auditoría y herramientas de desarrollo: nunca accesibles por web.
# (La raíz también los bloquea en .htaccess.) Compatible con Apache 2.2 y 2.4.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
