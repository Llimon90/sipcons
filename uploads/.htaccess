# Archivos adjuntos de incidencias y ventas: se sirven como archivos, nunca se
# ejecutan. Bloquea scripts del servidor aunque alguien lograra subir uno.
# Compatible con Apache 2.2 y 2.4.
<FilesMatch "(?i)\.(php\d?|phtml|phar|pht|cgi|pl|py|sh|asp|aspx|jsp)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
