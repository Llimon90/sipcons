# Carpeta de archivos subidos por usuarios: aquí nunca se ejecuta código.
# Se niega cualquier script del lado del servidor (y el propio .htaccess);
# los adjuntos (pdf, imágenes, office...) se sirven normalmente.
Options -ExecCGI -Indexes
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pl .py .cgi .sh
<FilesMatch "(?i)\.(php\d?|phtml|phar|pht|pl|py|cgi|sh|shtml|asp|aspx|jsp|htaccess|htpasswd)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Nota: con mod_rewrite el .htaccess raíz envía /uploads/... a
# backend/archivo.php (solo la empresa dueña), que aplica estas mismas reglas
# de caché. Lo siguiente cubre un servidor sin mod_rewrite.
# El .htaccess raíz prohíbe el caché en todo el sitio (no-store), lo que hacía
# descargar cada PDF/imagen completo una y otra vez (miniatura, visor, cada
# visita).
#  - Archivos con nombre único (inc<ID>_<fecha>_<hora>_<aleatorio>_...): nunca
#    cambian, se guardan 30 días en el navegador del usuario.
#  - Los demás (antiguos o de ventas, que podrían reemplazarse con el mismo
#    nombre): el navegador pregunta si cambiaron y, si no, no los descarga.
<IfModule mod_headers.c>
    Header unset Pragma
    Header unset Expires
    Header set Cache-Control "private, no-cache"
    <FilesMatch "^inc[0-9]+_[0-9]{8}_[0-9]{6}_[0-9a-f]{6}_">
        Header set Cache-Control "private, max-age=2592000, immutable"
    </FilesMatch>
</IfModule>
